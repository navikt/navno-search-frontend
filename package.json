{
	"name": "navno-search-frontend",
	"version": "1.0.16-prod",
	"private": true,
	"type": "module",
	"imports": {
		"#client/*": "./client/*",
		"#dist/*": "./dist/*",
		"#server/*": "./server/*",
		"#shared/*": "./shared/*",
		"#test/*": "./test/*"
	},
	"scripts": {
		"dev": "vite 2>&1 | pino-pretty --messageKey=message",
		"build": "vite build && vite build --ssr server/main.ts",
		"start": "NODE_ENV=production node --env-file=.env.development dist/server/main.js",
		"lint": "oxfmt --check && oxlint && tsc --noEmit",
		"format": "oxfmt",
		"prepare": "husky || true",
		"test": "vitest run",
		"test:dist": "node --test test/dist-smoke.ts",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@hono/node-server": "2.1.5",
		"@itsy/corgi": "1.4.1",
		"@itsy/html": "1.2.0",
		"@navikt/aksel-icons": "8.20.1",
		"@navikt/ds-css": "8.20.1",
		"@navikt/ds-react": "8.20.1",
		"@navikt/nav-dekoratoren-moduler": "4.5.3",
		"@navikt/pino-logger": "5.0.1",
		"@prometheus-io/client": "0.16.1",
		"hono": "4.13.14",
		"html-react-parser": "6.1.9",
		"pino": "10.4.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@hono/vite-dev-server": "0.26.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/jsdom": "30.0.0",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"husky": "9.1.7",
		"jsdom": "30.1.3",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"pino-pretty": "13.2.0",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
