{
    "name": "navno-search-frontend",
    "version": "1.0.16-prod",
    "private": true,
    "engines": {
        "node": "24"
    },
    "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8",
    "scripts": {
        "dev": "next dev -p 3001 2>&1 | pino-pretty --messageKey=message",
        "build": "next build",
        "start": "next start -p 3001",
        "start-clean": "rm -fr .next && pnpm run build && pnpm start",
        "lint": "eslint src/",
        "prepare": "husky || true",
        "test": "vitest run",
        "test:watch": "vitest",
        "pretest:http": "NODE_ENV=production ENV=localhost DECORATOR_LOCAL_URL=http://127.0.0.1:9 NEXT_TELEMETRY_DISABLED=1 APP_BASE_PATH=/sok APP_ORIGIN=https://www.nav.test SEARCH_URL=http://navno-search-api.test/content/search pnpm run build",
        "test:http": "vitest run --config test/http/vitest.config.mts"
    },
    "dependenciesComments": {
        "@types/node": "Holdes på samme major som LTS node-versjon. Siste LTS node-versjon er 24, derfor @types/node@24"
    },
    "dependencies": {
        "@navikt/aksel-icons": "8.17.2",
        "@navikt/ds-css": "8.17.2",
        "@navikt/ds-react": "8.17.2",
        "@navikt/ds-tokens": "8.17.2",
        "@navikt/nav-dekoratoren-moduler": "4.5.0",
        "@navikt/next-logger": "^5.0.1",
        "@prometheus-io/client": "0.16.1",
        "dayjs": "1.11.23",
        "html-react-parser": "6.1.8",
        "js-cookie": "3.0.8",
        "next": "16.4.1",
        "pino": "10.3.1",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "5.23.3",
        "@next/eslint-plugin-next": "16.3.8",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/js-cookie": "3.0.6",
        "@types/jsdom": "30.0.0",
        "@types/node": "24.1.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "10.11.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "husky": "9.1.7",
        "jsdom": "30.1.1",
        "pino-pretty": "13.1.3",
        "prettier": "3.9.9",
        "sass": "1.105.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "undici": "8.12.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "browser": {
        "jsdom": false
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.19.0",
            "onFail": "download"
        }
    }
}
