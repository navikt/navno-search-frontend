{
	"name": "navno-search-frontend",
	"version": "1.0.16-prod",
	"private": true,
	"type": "module",
	"imports": {
		"#client/*": "./client/*",
		"#dist/*": "./dist/*",
		"#server/*": "./server/*",
		"#shared/*": "./shared/*",
		"#test/*": "./test/*"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && vite build --ssr server/main.ts",
		"start": "NODE_ENV=production node --env-file=.env.development dist/server/main.js",
		"lint": "oxfmt --check && oxlint && tsc --noEmit",
		"format": "oxfmt",
		"prepare": "husky || true",
		"test": "vitest run",
		"test:dist": "node --test test/dist-smoke.ts",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@hono/node-server": "2.1.6",
		"@itsy/corgi": "1.4.1",
		"@itsy/html": "1.2.0",
		"@navikt/aksel-icons": "8.22.1",
		"@navikt/ds-css": "8.22.1",
		"@navikt/ds-react": "8.22.1",
		"@navikt/nav-dekoratoren-moduler": "4.6.0",
		"@navikt/navno-logger": "1.1.0",
		"@prometheus-io/client": "0.16.1",
		"hono": "4.13.16",
		"html-react-parser": "6.1.9",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@hono/vite-dev-server": "0.26.1",
		"@navikt/browserslist-config-public": "^1.0.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/jsdom": "30.0.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"husky": "9.1.7",
		"jsdom": "30.1.3",
		"oxfmt": "0.76.0",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2005",
		"pino-pretty": "13.2.0",
		"typescript": "7.0.2",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
