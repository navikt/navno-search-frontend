{
    "name": "navno-search-frontend",
    "version": "1.0.16-prod",
    "private": true,
    "engines": {
        "node": "26"
    },
    "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
    "scripts": {
        "dev": "next dev -p 3001 2>&1 | pino-pretty --messageKey=message",
        "build": "next build",
        "start": "next start -p 3001",
        "start-clean": "rm -fr .next && pnpm run build && pnpm start",
        "lint": "eslint src/",
        "prepare": "husky || true",
        "test": "jest --collectCoverage",
        "test:watch": "jest --watch"
    },
    "dependenciesComments": {
        "@types/node": "Holdes på samme major som LTS node-versjon. Siste LTS node-versjon er 24, derfor @types/node@24"
    },
    "dependencies": {
        "@navikt/aksel-icons": "8.17.2",
        "@navikt/ds-css": "8.17.2",
        "@navikt/ds-react": "8.17.2",
        "@navikt/ds-tokens": "8.17.2",
        "@navikt/nav-dekoratoren-moduler": "4.5.0",
        "@navikt/next-logger": "^5.0.1",
        "@prometheus-io/client": "0.16.1",
        "@types/jest": "^30.0.0",
        "dayjs": "1.11.23",
        "html-react-parser": "6.1.8",
        "js-cookie": "3.0.8",
        "next": "16.4.1",
        "pino": "10.3.1",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "5.23.3",
        "@next/eslint-plugin-next": "16.3.8",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/js-cookie": "3.0.6",
        "@types/node": "24.1.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "10.11.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "husky": "9.1.7",
        "jest": "30.5.2",
        "jest-environment-jsdom": "30.5.2",
        "jsdom": "30.1.1",
        "pino-pretty": "13.1.3",
        "prettier": "3.9.9",
        "sass": "1.105.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0"
    },
    "browser": {
        "jsdom": false
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher"
        ]
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26",
            "onFail": "download"
        }
    }
}
