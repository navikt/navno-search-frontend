{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "esnext"
    ],
    "types": [
      "@testing-library/jest-dom"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "utils/*": ["./src/utils/*"],
      "context/*": ["./src/context/*"],
      "types/*": ["./src/types/*"],
      "components/*": ["./src/components/*"],
      "config": ["./src/config"],
      "testHelpers/*": ["./src/testHelpers/*"],
      "jest-utils": ["./src/jest-utils.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
